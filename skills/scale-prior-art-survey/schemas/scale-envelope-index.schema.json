{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scale-envelope-index.schema.json",
  "title": "The scale envelope index (wave 3)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "as_of",
    "project_band",
    "lineage",
    "areas",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "initial",
        "delta"
      ],
      "description": "`initial` or `delta`. DECLARED because the delta-mode validator rule reads it: with this root closed to additional properties, an index carrying `mode: delta` was refused by the schema itself, so the rule could only fire on a document the gate had already rejected. A rule unreachable on every valid artifact is as dead as a field nothing reads."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "project_band": {
      "type": "object",
      "properties": {
        "concurrency": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high",
            "extreme"
          ]
        },
        "real_time": {
          "type": "string",
          "enum": [
            "none",
            "soft",
            "near",
            "hard"
          ]
        },
        "availability_target": {
          "type": "string",
          "enum": [
            "99",
            "99.9",
            "99.95",
            "99.99",
            "99.999"
          ]
        },
        "geo_distribution": {
          "type": "string",
          "enum": [
            "single-region",
            "multi-region",
            "global",
            "edge"
          ]
        },
        "data_volume": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large",
            "extreme"
          ]
        }
      },
      "required": [
        "availability_target",
        "concurrency",
        "data_volume",
        "geo_distribution",
        "real_time"
      ],
      "additionalProperties": false,
      "description": "The same five leaves the map carries, so the index is readable without the map."
    },
    "lineage": {
      "type": "object",
      "properties": {
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "extends"
      ],
      "additionalProperties": false,
      "description": "Links a delta run's evidence to its baseline. DECLARED HERE because a delta-mode validator rule READS it: this is the half that reverted silently when a fix landed only on the validator side, and it is why `lineage` shipped dead in two packages."
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1
          },
          "default_pattern": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Episode ids, ALWAYS \u2014 L-3's anti-drift guard. Never a prose citation, and every id must RESOLVE to an episode in an extracted record."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "moderate",
              "low",
              "very-low"
            ]
          },
          "hard_limits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "limit": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The EPISODE ID this limit came from \u2014 despite the field's name, not a prose citation. It resolves like every other evidence site."
                },
                "adjustable": {
                  "type": "boolean"
                },
                "blocks_requirement": {
                  "type": "boolean"
                }
              },
              "required": [
                "limit",
                "source",
                "adjustable",
                "blocks_requirement"
              ],
              "additionalProperties": false
            }
          },
          "failure_modes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cause_class": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "cause_class",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "migration_trigger": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "trigger": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dimension": {
                    "type": "string",
                    "enum": [
                      "availability_target",
                      "concurrency",
                      "data_volume",
                      "geo_distribution",
                      "real_time"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "trigger",
                  "dimension",
                  "evidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "open_gap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "currency": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "dates": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "EVERY distinct `published_date` among the backing episodes' sources, across all four evidence sites \u2014 each transcribed in the form its source carries it. Compared to the derived set by EQUALITY, in both directions, so no date is missed and none is invented.",
                    "uniqueItems": true
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1,
                    "description": "What those dates mean for a reader acting on this area today. The dates are the gate's half; this is the caveat."
                  }
                },
                "required": [
                  "dates",
                  "note"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Lens 8, STRUCTURED. A free-text caveat had to be pattern-matched for the dates it named, and no lookaround survives a field that admits a publication date, a benchmark result date, a documentation version and an incident date: matching was delimited across `-` and digits only, so a slash date or a version string still hid a shorter one inside a longer, while a correct caveat writing a span as `2019-2024` was refused. Splitting the field removes the parsing: `dates` is compared by equality and `note` carries the reading. Null ONLY where every backing source is undated, and a null on a dated corpus is refused."
          }
        },
        "required": [
          "area",
          "default_pattern",
          "evidence",
          "confidence",
          "hard_limits",
          "failure_modes",
          "migration_trigger",
          "open_gap",
          "currency"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  }
}
